# ==========================================
# MasterCue Studio Configuration
# ==========================================

# Database Connection (Optional locally, recommended for production)
# When set, the system automatically uses PostgreSQL (Supabase / Neon / Railway / AWS RDS)
# If left unset, the system uses the local persistent database store in data/
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Administrator Credentials (Default fallback provided if unset)
ADMIN_EMAIL=admin@mastercue.com
ADMIN_PASSWORD=MasterCue2026!

# Cryptographic Session Secret
SESSION_SECRET=mastercue-production-secret-salt-2026
